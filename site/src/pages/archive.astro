---
import Base from '../layouts/Base.astro';
---
<Base title="Rundale Bench · Archive"><main><section class="hero"><p class="eyebrow">ARCHIVE</p><h1>Published evaluation versions</h1><p>Open a version to inspect its latest results and other recorded runs.</p></section><section><h2>Before version 3.0</h2><p>Historical results use different coverage and rubrics and are not comparable to 3.0.</p><ul><li><a href="/rundale-bench/archive/pre-3.0/dialogue-qualification.json">Cloud dialogue qualification records</a></li><li><a href="/rundale-bench/archive/pre-3.0/leaderboard.jsonl">Preliminary local leaderboard</a></li><li><a href="/rundale-bench/archive/pre-3.0/provenance.json">Source revisions and hashes</a></li></ul></section><section id="archive-list" class="archive-list"><p>Loading archived versions…</p></section></main><script>
// @ts-nocheck
const root='/rundale-bench';let data;try{data=await(await fetch(`${root}/results.json`)).json()}catch{data={versions:[]}}const items=data.versions||[];const host=document.getElementById('archive-list');host.replaceChildren();if(!items.length){host.textContent='No published versions are currently available.'}for(const version of items){const link=document.createElement('a');link.className='archive-card';link.href=`${root}/?version=${encodeURIComponent(version.version)}`;const title=document.createElement('span');title.textContent=`Version ${version.version}`;const count=document.createElement('strong');const runCount=(version.runs||[]).length;count.textContent=`${runCount} published ${runCount===1?'run':'runs'}`;const qualification=document.createElement('small');qualification.textContent=`Qualification: ${version.qualification?.status||'archived'}`;link.append(title,count,qualification);host.append(link)}
</script></Base>
